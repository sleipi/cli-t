{
  "name": "clitest",
  "displayName": "clitest",
  "description": "Syntax highlighting for .clitest files (CLI Test)",
  "version": "0.1.0",
  "publisher": "sleipi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleipi/cli-t"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "clitest",
        "aliases": [
          "CLI Test",
          "clitest"
        ],
        "extensions": [
          ".clitest"
        ],
        "icon": {
          "light": "./icons/clitest-icon-a-dollar-green-64.png",
          "dark": "./icons/clitest-icon-a-dollar-green-64.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clitest",
        "scopeName": "source.clitest",
        "path": "./syntaxes/clitest.tmLanguage.json"
      }
    ]
  }
}
