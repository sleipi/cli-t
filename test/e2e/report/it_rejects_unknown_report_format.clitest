# Only the junit format is supported
./clitest --report tap:/dev/null test/_fixtures/failing.clitest
EXIT 2
[asserts]
stderr contains "unsupported report format "tap""
stdout isEmpty

# A value without a path is rejected
./clitest --report junit test/_fixtures/failing.clitest
EXIT 2
[asserts]
stderr contains "use junit:PATH"

# Only one report per run
./clitest --report junit:/dev/null --report junit:/dev/null test/_fixtures/failing.clitest
EXIT 2
[asserts]
stderr contains "--report can only be given once"
stdout isEmpty
